# Server-side only. Never put a real key into dist/, browser JS, GitHub Pages, or Git.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
# Choose an enabled model supporting Chat Completions and structured JSON output.
AI_MODEL=
AI_RESPONSE_FORMAT=json_schema
AI_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
AI_REQUESTS_PER_MINUTE=6
AI_DAILY_REQUEST_LIMIT=250
AI_MAX_CONCURRENT=3
AI_TIMEOUT_MS=25000
AI_MAX_COMPLETION_TOKENS=1400
AI_PORT=8787
AI_BIND_HOST=127.0.0.1
# For deployed Node behind a proxy, use the API's actual public origin.
# AI_SERVER_ORIGIN=https://api.example.com
# Worker only: fixed HTTPS URL of the deployed catalog, never provided by visitors.
# CATALOG_URL=https://your-account.github.io/your-repo/data.json
